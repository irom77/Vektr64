# Lichess API token for the Vektr64 BOT account. Scope needed: bot:play
# Create one at https://lichess.org/account/oauth/token
LICHESS_TOKEN=

# Hugging Face token with write access, for the external store (versions, match
# results, game records). Create one at https://huggingface.co/settings/tokens
HF_TOKEN=

# RunPod API key, for `vektr-ops burst` (rented GPU training). Create one at
# https://www.runpod.io/console/user/settings (API Keys). Scope: pods read and write.
RUNPOD_API_KEY=

# Optional: a fine-grained Hugging Face token limited to the two vektr64-* repos. If set, the
# rented pod gets this instead of HF_TOKEN, so the full token never leaves your machines.
HF_BURST_TOKEN=
